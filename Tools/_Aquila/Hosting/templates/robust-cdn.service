[Unit]
Description=Robust.Cdn (Aquila)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=ss14
Group=ss14
WorkingDirectory=/opt/robust-cdn
ExecStart=/opt/robust-cdn/bin/Robust.Cdn
Restart=always
RestartSec=5
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=DOTNET_ROOT=/usr/share/dotnet

[Install]
WantedBy=multi-user.target
