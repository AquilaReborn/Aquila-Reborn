{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Robust": "Information"
    }
  },
  "Manifest": {
    "FileDiskPath": "/opt/robust-cdn/builds",
    "DatabaseFileName": "/opt/robust-cdn/database/manifest.db",
    "Forks": {
      "aquila": {
        "UpdateToken": "@PUBLISH_TOKEN@",
        "Private": false,
        "PruneBuildsDays": 30,
        "DisplayName": "Aquila",
        "NotifyWatchdogs": [
          {
            "WatchdogUrl": "http://localhost:5000",
            "Instance": "aquila",
            "ApiToken": "@WATCHDOG_TOKEN@"
          }
        ]
      }
    }
  },
  "Cdn": {
    "DatabaseFileName": "/opt/robust-cdn/database/content.db",
    "StreamCompressLevel": 5
  },
  "BaseUrl": "https://@CDN_DOMAIN@/",
  "PathBase": "/",
  "AllowedHosts": "*",
  "Urls": "http://localhost:27690/"
}
