[Unit]
Description=SS14 Watchdog (Aquila)
After=network-online.target postgresql.service robust-cdn.service
Wants=network-online.target

[Service]
Type=simple
User=ss14
Group=ss14
WorkingDirectory=/opt/ss14/watchdog
ExecStart=/opt/ss14/watchdog/SS14.Watchdog
Restart=always
RestartSec=5
# Не убивать игровой сервер вместе с watchdog, он подхватит его после перезапуска.
KillMode=process
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=DOTNET_ROOT=/usr/share/dotnet
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
