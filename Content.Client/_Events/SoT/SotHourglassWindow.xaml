<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls;assembly=Content.Client"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      x:Class="Content.Client._Kakila.Sot.SotHourglassWindow"
                      Title="{Loc 'sot-hourglass-window-title'}"
                      MinSize="340 260">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="8" SeparationOverride="6">
        <Label Name="ShipLabel" HorizontalAlignment="Center" StyleClasses="LabelBig"/>
        <Label Name="PhaseLabel" HorizontalAlignment="Center"/>
        <ProgressBar Name="VotesBar" HorizontalExpand="True" MinValue="0.0" MaxValue="1.0" Value="0.0" SetHeight="24"/>
        <Label Name="VotesLabel" HorizontalAlignment="Center"/>
        <RichTextLabel Name="InfoLabel" HorizontalExpand="True" Margin="0 4 0 4"/>
        <Button Name="VoteButton" HorizontalExpand="True" SetHeight="40"/>
    </BoxContainer>
</controls:FancyWindow>