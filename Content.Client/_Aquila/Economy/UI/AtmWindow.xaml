<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      SetSize="420 380"
                      MinSize="380 320">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
        <Label Name="NoAccountLabel"
               Text="{Loc 'atm-ui-no-account'}"
               HorizontalAlignment="Center"
               Visible="False"/>
        <Button Name="OpenAccountButton"
                Text="{Loc 'bank-ui-open-account'}"
                HorizontalAlignment="Center"
                Visible="False"/>
        <BoxContainer Name="AccountContainer" Orientation="Vertical" SeparationOverride="4">
            <Label Name="OwnerLabel" StyleClasses="LabelHeading" ClipText="True"/>
            <Label Name="NumberLabel" StyleClasses="LabelSubText"/>
            <Label Name="BalanceLabel" StyleClasses="LabelBig"/>
            <BoxContainer Orientation="Horizontal" SeparationOverride="4" Margin="0 4 0 0">
                <LineEdit Name="AmountInput" HorizontalExpand="True" PlaceHolder="{Loc 'atm-ui-amount'}"/>
                <Button Name="WithdrawButton" Text="{Loc 'atm-ui-withdraw'}"/>
            </BoxContainer>
            <BoxContainer Orientation="Vertical" SeparationOverride="4">
                <Label Name="SecurityLabel" StyleClasses="LabelSubText"/>
                <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                    <Button Name="SecurityLevel0Button"
                            Text="{Loc 'atm-security-level-low'}"
                            ToolTip="{Loc 'atm-ui-security-hint-0'}"
                            HorizontalExpand="True"
                            StyleClasses="OpenRight"/>
                    <Button Name="SecurityLevel1Button"
                            Text="{Loc 'atm-security-level-medium'}"
                            ToolTip="{Loc 'atm-ui-security-hint-1'}"
                            HorizontalExpand="True"
                            StyleClasses="OpenBoth"/>
                    <Button Name="SecurityLevel2Button"
                            Text="{Loc 'atm-security-level-high'}"
                            ToolTip="{Loc 'atm-ui-security-hint-2'}"
                            HorizontalExpand="True"
                            StyleClasses="OpenLeft"/>
                </BoxContainer>
            </BoxContainer>
            <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                <LineEdit Name="OldPinInput" HorizontalExpand="True" PlaceHolder="{Loc 'atm-ui-old-pin'}"/>
                <LineEdit Name="NewPinInput" HorizontalExpand="True" PlaceHolder="{Loc 'atm-ui-new-pin'}"/>
                <Button Name="ChangePinButton" Text="{Loc 'atm-ui-change-pin'}"/>
            </BoxContainer>
        </BoxContainer>
        <Label Text="{Loc 'atm-ui-deposit-hint'}" StyleClasses="LabelSubText"/>
    </BoxContainer>
</controls:FancyWindow>
