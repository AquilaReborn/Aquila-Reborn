<BoxContainer xmlns="https://spacestation14.io"
              xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
              Orientation="Vertical"
              Margin="5 2 5 2">
    <PanelContainer HorizontalExpand="True">
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BorderThickness="1" BorderColor="#777777" BackgroundColor="#393c3f"/>
        </PanelContainer.PanelOverride>
        <Collapsible Name="ExtractCollapsible" HorizontalExpand="True">
            <CollapsibleHeading Name="ExtractHeading" Margin="4 2 4 2"/>
            <CollapsibleBody>
                <BoxContainer Name="ReactionsContainer" Orientation="Vertical" Margin="8 0 8 8"/>
            </CollapsibleBody>
        </Collapsible>
    </PanelContainer>
</BoxContainer>
