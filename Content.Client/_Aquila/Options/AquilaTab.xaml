<Control xmlns="https://spacestation14.io"
         xmlns:ui="clr-namespace:Content.Client.Options.UI">
    <BoxContainer Orientation="Vertical">
        <ScrollContainer HScrollEnabled="False"
                         VerticalExpand="True">
            <BoxContainer Orientation="Vertical"
                          Margin="8 8 8 8">
                <Label Text="{Loc 'ui-options-aquila-audio-label'}"
                       StyleClasses="LabelKeyText"/>
                <BoxContainer Orientation="Vertical"
                              Margin="0 3 0 0">
                    <ui:OptionSlider Name="SliderVolumeRadioMusic"
                                     Title="{Loc 'ui-options-radio-music-volume'}"/>
                    <ui:OptionSlider Name="SliderVolumeAdminMusic"
                                     Title="{Loc 'ui-options-admin-music-volume'}"
                                     Margin="0 0 0 8"/>
                    <CheckBox Name="AudioEnvironmentCheckBox"
                              Text="{Loc 'ui-options-audio-environment'}"/>
                </BoxContainer>
                <Label Text="{Loc 'ui-options-aquila-action-binds'}"
                       StyleClasses="LabelKeyText"
                       Margin="0 8 0 0"/>
                <Label Text="{Loc 'ui-options-aquila-action-binds-hint'}"
                       StyleClasses="LabelSubText"
                       Margin="5 0 0 4"/>
                <BoxContainer Name="ActionBindsContainer"
                              Orientation="Vertical"/>
            </BoxContainer>
        </ScrollContainer>
        <ui:OptionsTabControlRow Name="Control"
                                 Access="Public"/>
    </BoxContainer>
</Control>
