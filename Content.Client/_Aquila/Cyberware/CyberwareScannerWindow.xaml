<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'cyberware-scanner-ui-title'}"
                      MinSize="360 300"
                      SetSize="360 460">
    <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
        <BoxContainer Orientation="Vertical" Margin="10 6 10 10">
            <Label Name="EmptyLabel"
                   Text="{Loc 'cyberware-scanner-ui-empty'}"
                   StyleClasses="LabelSubText" />
            <BoxContainer Name="ResultContainer" Orientation="Vertical" Visible="False">
                <Label Name="TargetLabel" StyleClasses="LabelHeading" ClipText="True" />
                <Label Name="ScanTypeLabel" StyleClasses="LabelSubText" />
                <PanelContainer StyleClasses="LowDivider" Margin="0 6" />

                <Label Text="{Loc 'cyberware-scanner-ui-load'}" StyleClasses="LabelKeyText" />
                <ProgressBar Name="RiskBar"
                             MinValue="0"
                             MaxValue="1"
                             SetHeight="22"
                             HorizontalExpand="True"
                             Margin="0 4">
                    <Label Name="RiskText" HorizontalAlignment="Center" />
                </ProgressBar>
                <GridContainer Columns="2" HSeparationOverride="12">
                    <Label Text="{Loc 'cyberware-scanner-ui-count'}" StyleClasses="LabelSubText" />
                    <Label Name="CountLabel" />
                    <Label Text="{Loc 'cyberware-scanner-ui-level'}" StyleClasses="LabelSubText" />
                    <Label Name="LevelLabel" />
                </GridContainer>
                <Label Name="AdaptingLabel"
                       Text="{Loc 'cyberware-scanner-adapting'}"
                       Visible="False" />
                <PanelContainer StyleClasses="LowDivider" Margin="0 6" />

                <Label Text="{Loc 'cyberware-scanner-ui-implants'}" StyleClasses="LabelKeyText" />
                <BoxContainer Name="ImplantList" Orientation="Vertical" Margin="6 4 0 4" />
                <Label Name="ConcealedLabel" Visible="False" />

                <BoxContainer Name="PsychosisSection" Orientation="Vertical" Visible="False">
                    <PanelContainer StyleClasses="LowDivider" Margin="0 6" />
                    <Label Text="{Loc 'cyberware-scanner-ui-psychosis'}" StyleClasses="LabelKeyText" />
                    <Label Name="StageLabel" Margin="0 4" />
                    <ProgressBar Name="CureBar"
                                 MinValue="0"
                                 MaxValue="1"
                                 SetHeight="22"
                                 HorizontalExpand="True"
                                 Visible="False">
                        <Label Name="CureText" HorizontalAlignment="Center" />
                    </ProgressBar>
                </BoxContainer>
            </BoxContainer>
        </BoxContainer>
    </ScrollContainer>
</controls:FancyWindow>
