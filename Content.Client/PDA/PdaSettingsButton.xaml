<pda:PdaSettingsButton xmlns="https://spacestation14.io"
                       xmlns:pda="clr-namespace:Content.Client.PDA"
                       HorizontalExpand="True"
                       MinHeight="48"
                       Margin="0 2 0 0">
<!-- Aquila Change start -->
<PanelContainer Name="Panel"/>
<BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="10 6 10 6">
        <Label Name="OptionName"/>
        <Label Name="OptionDescription" StyleClasses="PdaSettingsDescription"/>
    </BoxContainer>
    <PanelContainer Name="Separator" SetHeight="1" Margin="10 0"/>
</BoxContainer>
<!-- Aquila Change end -->
</pda:PdaSettingsButton>
