light_mode unshaded;

uniform sampler2D SCREEN_TEXTURE;

void fragment() {
    highp vec4 pixel = zTextureSpec(SCREEN_TEXTURE, UV);
    highp float gray = dot(pixel.rgb, vec3(0.299, 0.587, 0.114));
    highp vec3 darkened = vec3(gray) * 0.90; // чуть темнее обычного
    COLOR = vec4(darkened, pixel.a);
}