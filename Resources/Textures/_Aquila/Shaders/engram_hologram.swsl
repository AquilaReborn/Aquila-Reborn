light_mode unshaded;

highp float hash(highp float n)
{
    return fract(sin(n) * 43758.5453);
}

void fragment()
{
    highp vec4 base = texture2D(TEXTURE, UV);
    highp float gray = zGrayscale(base.rgb);
    highp float t = TIME;

    highp vec3 holo = mix(vec3(0.15, 0.85, 1.0), vec3(0.6, 1.0, 0.85), gray) * (0.55 + gray * 0.9);

    highp float scan = 0.7 + 0.3 * step(0.5, fract(UV.y * 16.0 - t * 1.5));
    highp float flicker = 0.85 + 0.15 * sin(t * 23.0) * sin(t * 7.3);
    highp float glitch = step(0.94, hash(floor(t * 8.0)));
    highp float band = step(0.85, hash(floor(UV.y * 10.0) + floor(t * 10.0))) * glitch;

    holo = mix(holo, vec3(1.0, 0.35, 0.6), band * 0.6);
    highp float alpha = base.a * 0.65 * scan * flicker * (1.0 - glitch * 0.35);

    COLOR = vec4(holo, alpha);
}
