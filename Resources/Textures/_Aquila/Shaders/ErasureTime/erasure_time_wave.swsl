light_mode unshaded;
blend_mode mix;

uniform highp float progress;

highp float hash(highp vec2 p)
{
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
}

highp float noise(highp vec2 p)
{
    highp vec2 i = floor(p);
    highp vec2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    highp float a = hash(i);
    highp float b = hash(i + vec2(1.0, 0.0));
    highp float c = hash(i + vec2(0.0, 1.0));
    highp float d = hash(i + vec2(1.0, 1.0));
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

highp vec2 rotate(highp vec2 p, highp float a)
{
    highp float s = sin(a);
    highp float c = cos(a);
    return vec2(p.x * c - p.y * s, p.x * s + p.y * c);
}

void fragment()
{
    highp vec2 uv = FRAGCOORD.xy * SCREEN_PIXEL_SIZE;

    highp float waveCenter = 1.2 - progress * 1.4;
    highp float dist = abs(uv.x - waveCenter);
    highp float bandWidth = 0.64;
    highp float band = 1.0 - smoothstep(0.0, bandWidth, dist);

    highp vec2 veinUV1 = rotate(uv, 0.6) * vec2(5.0, 18.0) + progress * vec2(8.0, 3.0);
    highp vec2 veinUV2 = rotate(uv, -0.9) * vec2(4.0, 22.0) - progress * vec2(6.0, 4.0);
    highp float n1 = noise(veinUV1);
    highp float n2 = noise(veinUV2);
    highp float vein1 = 1.0 - smoothstep(0.0, 0.07, abs(n1 - 0.5));
    highp float vein2 = 1.0 - smoothstep(0.0, 0.05, abs(n2 - 0.5));
    highp float redStreaks = clamp(vein1 + vein2 * 0.7, 0.0, 1.0);

    highp vec2 streakUV = rotate(uv, 0.15) * vec2(6.0, 140.0) + progress * vec2(14.0, 0.0);
    highp float streaks = noise(streakUV) * noise(streakUV * 2.3 + vec2(11.0, 0.0));
    streaks = pow(streaks, 3.0);

    highp float blobs = noise(uv * 3.5 + progress * 1.5) * 0.6
                       + noise(uv * 7.1 - progress * 0.7) * 0.4;

    highp vec3 darkPurple = vec3(0.12, 0.02, 0.18);
    highp vec3 magenta    = vec3(0.85, 0.05, 0.55);
    highp vec3 darkRed    = vec3(0.45, 0.02, 0.05);
    highp vec3 hotPink    = vec3(1.0, 0.65, 0.85);

    highp vec3 color = mix(darkPurple, magenta, blobs);
    color = mix(color, darkRed, redStreaks * 0.85);
    color = mix(color, hotPink, streaks);

    highp float fade = sin(progress * 3.14159);
    highp float alpha = band * fade;
    alpha = clamp(alpha + streaks * band * 0.3, 0.0, 1.0);

    COLOR = vec4(color, alpha);
}