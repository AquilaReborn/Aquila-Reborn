// Работа выполнена Claude (Anthropic).
// Проклятие SoT. Спрайт персонажа (тело + одежда + предметы) сначала целиком рисуется в промежуточный буфер,
// а этот шейдер выводит готовый силуэт ОДНИМ слоем: оттенок и прозрачность применяются ко всему сразу,
// поэтому тело не просвечивает сквозь одежду.
//
// tint.rgb - оттенок (умножается на цвет спрайта), tint.a - прозрачность. Задаётся из SotCurse.Color.
//
// ИЗМЕНИТЬ: чтобы проклятый светился в темноте (не затемнялся освещением), добавьте первой строкой файла:
light_mode unshaded;

uniform highp vec4 tint;

void fragment()
{
    // Буфер хранит цвет, уже умноженный на альфу, поэтому сначала возвращаем чистый цвет.
    highp vec4 base = texture2D(TEXTURE, UV);
    highp vec3 rgb = base.rgb / max(base.a, 0.001);
    highp float alpha = base.a * tint.a;

    COLOR = vec4(rgb * tint.rgb * alpha, alpha);
}
