# Работа выполнена Claude (Anthropic).
# Выплаты за битвы SoT на личные счета.

# --- Причины в истории операций ---
sot-bank-transaction-win = Награда за победу в битве
sot-bank-transaction-lose = Выплата за участие в битве
sot-bank-transaction-draw = Выплата за ничью в битве

# Пояснение к операции
sot-payout-comment = Битва №{ $number }

# --- Уведомления игрокам ---
sot-payout-notification-win = Ваша фракция победила в битве №{ $number }! На ваш счёт зачислено { $amount } кредитов.
sot-payout-notification-lose = Ваша фракция проиграла в битве №{ $number }. За участие на ваш счёт зачислено { $amount } кредитов.
sot-payout-notification-draw = Битва №{ $number } закончилась вничью. На ваш счёт зачислено { $amount } кредитов.
